# Copiá este archivo como `.env` y completá los valores.
# El `.env` está en .gitignore: nunca se commitea.

# --- Django ---------------------------------------------------------------
# En desarrollo se puede dejar como está. Para producción generá una con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-insegura-solo-para-desarrollo
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos --------------------------------------------------------
# Vacío = SQLite local. En Render, Postgres inyecta DATABASE_URL solo.
# DATABASE_URL=postgres://usuario:clave@host:5432/basededatos

# --- Mercado Pago ---------------------------------------------------------
# Credenciales de PRUEBA: https://www.mercadopago.com.ar/developers/panel
# El access token de test empieza con "TEST-".
#
# Ojo con el checkout en local: `auto_return` y el webhook necesitan una URL
# pública https. Con localhost la preferencia se crea igual (el código omite
# esos dos campos), pero la vuelta del pago y el aviso solo funcionan una vez
# deployado. Ver README.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# --- Dominio y buscadores --------------------------------------------------
# URL pública de la tienda, sin barra final. Tiene que ser EXACTAMENTE la que
# está registrada en la app de Mercado Pago.
# SITIO_URL=https://chao-ecommerce.vercel.app
#
# Apagado = todas las páginas salen con noindex y no hay sitemap. Se prende
# recién con el dominio definitivo en SITIO_URL y el visto bueno de CHAO.
PERMITIR_INDEXADO=False

# --- Panel de la dueña (/gestion/) ----------------------------------------
# Con estas dos variables, `manage.py crear_duena` crea (o actualiza) la usuaria
# del panel. La clave vive acá o en el hosting, nunca en el repo.
GESTION_USUARIO=
GESTION_CLAVE=
GESTION_NOMBRE=

# --- Solo en Render -------------------------------------------------------
# Ruta del disco persistente, si se contrata uno para las fotos que suba la
# dueña desde el panel. Sin esto, lo subido se borra en cada deploy.
# MEDIA_ROOT=/var/data/media

# --- Solo en producción (Vercel) ------------------------------------------
# App "Operon Tiendas" de Mercado Pago, para el botón "Conectar Mercado Pago"
# del panel, y la clave con la que se verifica la firma del webhook.
# MP_CLIENT_ID=
# MP_CLIENT_SECRET=
# MP_WEBHOOK_SECRET=
#
# Los carga la integración de Supabase: base de datos y fotos subidas.
# POSTGRES_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
