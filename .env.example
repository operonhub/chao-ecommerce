# Copiá este archivo como `.env` y completá los valores.
# El `.env` está en .gitignore: nunca se commitea.

# --- Django ---------------------------------------------------------------
# En desarrollo se puede dejar como está. Para producción generá una con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=dev-insegura-solo-para-desarrollo
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos --------------------------------------------------------
# Vacío = SQLite local. En Render, Postgres inyecta DATABASE_URL solo.
# DATABASE_URL=postgres://usuario:clave@host:5432/basededatos

# --- Mercado Pago ---------------------------------------------------------
# Credenciales de PRUEBA: https://www.mercadopago.com.ar/developers/panel
# El access token de test empieza con "TEST-".
#
# Ojo con el checkout en local: `auto_return` y el webhook necesitan una URL
# pública https. Con localhost la preferencia se crea igual (el código omite
# esos dos campos), pero la vuelta del pago y el aviso solo funcionan una vez
# deployado. Ver README.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# --- Solo en Render -------------------------------------------------------
# Ruta del disco persistente, si se contrata uno para las fotos que suba la
# dueña desde el panel. Sin esto, lo subido se borra en cada deploy.
# MEDIA_ROOT=/var/data/media
